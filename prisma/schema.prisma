generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "inventory", "public"]
}

model item_allocation {
  id               Int               @id @default(autoincrement())
  req_item_id      Int?
  lot_id           String?           @db.Uuid
  qty              Int
  status           String?           @default("PENDING") @db.VarChar(20)
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  item_lot         item_lots?        @relation(fields: [lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_allocation_lot_fk")
  requisition_item requisition_item? @relation(fields: [req_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "item_allocation_req_item_fk")

  @@schema("inventory")
}

model items {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String
  code                          String                          @unique(map: "items_code_unique")
  category_id                   String?                         @db.Uuid
  unit_id                       String?                         @db.Uuid
  min_stock                     Int?                            @default(0)
  current_stock                 Int?                            @default(0)
  image_url                     String?
  status                        String?                         @default("ACTIVE") @db.VarChar(20)
  sell_price                    Decimal?                        @default(0) @db.Decimal(10, 2)
  created_at                    DateTime?                       @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime?                       @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                    DateTime?                       @db.Timestamptz(6)
  warehouse_id                  String?                         @db.Uuid
  description                   String?
  image_public_id               String?                         @db.VarChar(100)
  type                          String?                         @default("CONSUMABLE") @db.VarChar(20)
  allowed_req                   Boolean?                        @default(true)
  allowed_borrow                Boolean?                        @default(false)
  item_lots                     item_lots[]
  categories                    categories?                     @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_category_fk")
  unit                          units?                          @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_unit_fk")
  warehouses                    warehouses?                     @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_warehouse_fk")
  medical_assets                medical_assets[]
  receive_item                  receive_item[]
  requisition_item              requisition_item[]
  reusable_item_units           reusable_item_units[]
  reusable_return_request_items reusable_return_request_items[]
  stocks_movement               stocks_movement[]

  @@index([deleted_at], map: "idx_items_deleted_at")
  @@schema("inventory")
}

model logs_transaction {
  id            Int       @id @default(autoincrement())
  action        String    @db.VarChar(50)
  module        String    @db.VarChar(50)
  code          String?   @db.VarChar(50)
  status        String?   @db.VarChar(20)
  description   String?
  created_by    String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id String?   @db.Uuid

  @@index([action])
  @@index([code])
  @@index([created_at])
  @@schema("inventory")
}

model requisition_header {
  id                                                 Int                @id @default(autoincrement())
  doc_no                                             String             @unique @db.VarChar(50)
  type                                               String             @db.VarChar(50)
  status                                             String?            @default("DRAFT") @db.VarChar(50)
  requester_id                                       String             @db.Uuid
  approver_id                                        String?            @db.Uuid
  request_date                                       DateTime?          @default(now()) @db.Timestamptz(6)
  due_date                                           DateTime?          @db.Timestamptz(6)
  return_date                                        DateTime?          @db.Timestamptz(6)
  note                                               String?
  created_at                                         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime?          @default(now()) @updatedAt @db.Timestamptz(6)
  borrower_id                                        String?            @db.Uuid
  department_id                                      Int?
  profiles_requisition_header_approver_idToprofiles  profiles?          @relation("requisition_header_approver_idToprofiles", fields: [approver_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_req_header_approver")
  departments                                        departments?       @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_department")
  profiles_requisition_header_requester_idToprofiles profiles           @relation("requisition_header_requester_idToprofiles", fields: [requester_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_req_header_requester")
  borrower_details                                   borrower_details?  @relation(fields: [borrower_id], references: [id], onUpdate: NoAction, map: "fk_requisition_borrower")
  requisition_item                                   requisition_item[]

  @@index([doc_no], map: "idx_req_header_doc_no")
  @@index([status], map: "idx_req_header_status")
  @@index([created_at], map: "idx_req_header_created_at")
  @@schema("inventory")
}

model requisition_item {
  id                 Int                @id @default(autoincrement())
  header_id          Int
  item_id            String?            @db.Uuid
  req_qty            Int
  approved_qty       Int?
  issued_qty         Int?               @default(0)
  returned_qty       Int?               @default(0)
  note               String?
  item_allocation    item_allocation[]
  requisition_header requisition_header @relation(fields: [header_id], references: [id], onDelete: Cascade, map: "requisition_item_header_fk")
  items              items?             @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "requisition_item_item_fk")
  return_log         return_log[]

  @@index([header_id], map: "idx_req_item_header")
  @@schema("inventory")
}

model categories {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  code_prefix String    @db.VarChar(10)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  item_type   String    @default("CONSUMABLE") @db.VarChar(20)
  items       items[]

  @@schema("inventory")
}

model item_lots {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_code        String            @db.VarChar(100)
  item_id         String?           @db.Uuid
  warehouse_id    String?           @db.Uuid
  quantity        Int?              @default(0)
  status          String?           @default("ACTIVE") @db.VarChar(20)
  expired_at      DateTime?         @db.Timestamptz(6)
  note            String?           @db.VarChar(255)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)
  item_allocation item_allocation[]
  items           items?            @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_lot_item_fk")
  warehouses      warehouses?       @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_lot_warehouse_fk")

  @@unique([item_id, lot_code], map: "item_lot_unique_idx")
  @@index([deleted_at], map: "idx_item_lots_deleted_at")
  @@index([expired_at], map: "idx_item_lots_expired_at")
  @@index([deleted_at, expired_at], map: "idx_item_lots_deleted_expired")
  @@index([item_id, quantity], map: "idx_item_lots_item_qty")
  @@schema("inventory")
}

model stocks_movement {
  id             Int       @id(map: "stock_movement_pkey") @default(autoincrement())
  item_id        String?   @db.Uuid
  lot_id         String?   @db.Uuid
  quantity       Int?      @default(0)
  type           String    @db.VarChar(50)
  note           String?
  created_by     String?
  created_by_id  String?   @db.Uuid
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  balance_before Int?      @default(0)
  balance_after  Int?      @default(0)
  items          items?    @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movement_item_fk")

  @@schema("inventory")
}

model units {
  id          String    @id(map: "unit_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  description String?
  deleted_at  DateTime? @db.Timestamptz(6)
  items       items[]

  @@schema("inventory")
}

model warehouses {
  id          String      @id(map: "warehouse_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  location    String?
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @updatedAt @db.Timestamptz(6)
  description String?
  deleted_at  DateTime?   @db.Timestamptz(6)
  item_lots   item_lots[]
  items       items[]

  @@schema("inventory")
}

model departments {
  id                       Int                        @id
  name                     String?                    @db.VarChar(255)
  description              String?                    @db.VarChar(255)
  created_at               DateTime?                  @db.Timestamptz(6)
  updated_at               DateTime?                  @db.Timestamptz(6)
  deleted_at               DateTime?                  @db.Timestamptz(6)
  is_disable               Boolean?
  code                     String?                    @db.VarChar
  name_en                  String?                    @db.VarChar(255)
  asset_units              asset_units[]
  medical_assets           medical_assets[]
  requisition_header       requisition_header[]
  reusable_item_units      reusable_item_units[]
  reusable_return_requests reusable_return_requests[]

  @@schema("public")
}

model reusable_return_requests {
  id                  Int                             @id @default(autoincrement())
  doc_no              String                          @unique @db.VarChar(50)
  department_id       Int
  preferred_pickup_at DateTime?                       @db.Timestamptz(6)
  note                String?
  status              String                          @default("REQUESTED") @db.VarChar(20)
  requested_by        String?                         @db.Uuid
  created_at          DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                        @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?                       @db.Timestamptz(6)
  request_items       reusable_return_request_items[]
  profiles            profiles?                       @relation(fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_requester_id")
  departments         departments                     @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reusable_return_request_department")

  @@index([department_id], map: "idx_reusable_return_requests_department")
  @@index([status], map: "idx_reusable_return_requests_status")
  @@schema("inventory")
}

model reusable_return_request_items {
  id            Int                      @id @default(autoincrement())
  request_id    Int
  item_id       String                   @db.Uuid
  requested_qty Int
  note          String?
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  items         items                    @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reusable_return_request_item_item")
  request       reusable_return_requests @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reusable_return_request_item_request")

  @@index([item_id], map: "idx_reusable_return_request_items_item")
  @@index([request_id], map: "idx_reusable_return_request_items_request")
  @@schema("inventory")
}

model supplier {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  contact             String?
  address             String?
  phone               String?
  tax_id              String?
  active              Boolean?        @default(true)
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?       @db.Timestamptz(6)
  bank_account_number String?         @db.VarChar(50)
  bank_account_name   String?         @db.VarChar(50)
  bank_name           String?         @db.VarChar(100)
  email               String?         @db.VarChar(100)
  contact_phone       String?         @db.VarChar
  receive_batch       receive_batch[]

  @@schema("public")
}

model receive_header {
  id                   Int              @id @default(autoincrement())
  doc_no               String           @unique @db.VarChar(50)
  type                 String           @db.VarChar(50)
  status               String?          @default("PENDING") @db.VarChar(50)
  note                 String?
  created_by           String?          @db.Uuid
  created_at           DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?        @default(now()) @db.Timestamptz(6)
  parent_id            Int?
  batch_id             Int?
  receive_batch        receive_batch?   @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  receive_header       receive_header?  @relation("receive_headerToreceive_header", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_receive_header receive_header[] @relation("receive_headerToreceive_header")
  users                profiles?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "receive_header_users_fk")
  receive_item         receive_item[]

  @@index([doc_no], map: "idx_receive_header_doc_no")
  @@index([type], map: "idx_receive_header_type")
  @@index([batch_id], map: "idx_receive_header_batch_id")
  @@schema("inventory")
}

model receive_item {
  id                  Int                   @id @default(autoincrement())
  header_id           Int
  item_id             String                @db.Uuid
  lot_code            String?               @db.VarChar(100)
  qty                 Int                   @default(0)
  cost_price          Decimal?              @default(0) @db.Decimal(10, 2)
  expired_at          DateTime?             @db.Timestamptz(6)
  expected_qty        Int                   @default(0)
  medical_assets      medical_assets[]
  receive_header      receive_header        @relation(fields: [header_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "receive_item_header_fk")
  items               items                 @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "receive_item_item_fk")
  reusable_item_units reusable_item_units[]

  @@index([header_id], map: "idx_receive_item_header")
  @@schema("inventory")
}

model lookup_mstatus {
  mstatus_code String @id(map: "PK_a8d2ed3ebeea14eeb4377c29ef3") @db.VarChar(1)
  mstatus      String @db.VarChar(100)

  @@schema("public")
}

model lookup_nations {
  nation_code String @id(map: "PK_aa8e225d54e36f787ea37fb1284") @db.VarChar(3)
  nation      String @db.VarChar(100)

  @@schema("public")
}

model lookup_occupations {
  occup_code String @id(map: "PK_ca5c5d4461da50573a0bbbcb199") @db.VarChar(5)
  name       String

  @@schema("public")
}

model lookup_titles {
  title_code       String             @id(map: "PK_7d56771b6d78cbe8690a44481cc") @db.VarChar(3)
  short_name       String?            @db.VarChar(50)
  name             String             @db.VarChar(100)
  is_common        Boolean?           @default(false)
  borrower_details borrower_details[]

  @@schema("public")
}

model lookup_abogroups {
  abogroup_code String @id(map: "PK_f5f242cd07364f860b626748768") @db.VarChar(1)
  abogroup      String @db.VarChar(10)

  @@schema("public")
}

model lookup_rh {
  rh_code String @id(map: "PK_517960fca1e64b73fec80761b30") @db.VarChar(1)
  rhgroup String @db.VarChar(10)

  @@schema("public")
}

model medical_assets {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_code      String        @unique @db.VarChar(50)
  item_id         String        @db.Uuid
  receive_item_id Int?
  serial_no       String?       @db.VarChar(100)
  department_id   Int?
  status          String        @default("READY") @db.VarChar(20)
  purchase_date   DateTime?     @db.Timestamptz(6)
  warranty_expire DateTime?     @db.Timestamptz(6)
  note            String?
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  asset_units     asset_units[]
  departments     departments?  @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_department")
  items           items         @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_item")
  receive_item    receive_item? @relation(fields: [receive_item_id], references: [id], onUpdate: NoAction, map: "fk_asset_receive_item")

  @@index([asset_code], map: "idx_medical_assets_asset_code")
  @@index([department_id], map: "idx_medical_assets_dept_id")
  @@index([item_id], map: "idx_medical_assets_item_id")
  @@index([status], map: "idx_medical_assets_status")
  @@schema("inventory")
}

model reusable_item_units {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_code       String                    @unique @db.VarChar(50)
  item_id         String                    @db.Uuid
  receive_item_id Int?
  serial_no       String?                   @db.VarChar(100)
  status          String                    @default("AVAILABLE") @db.VarChar(20)
  condition       String                    @default("GOOD") @db.VarChar(20)
  note            String?
  created_at      DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?                 @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?                 @db.Timestamptz(6)
  department_id   Int?
  movement_logs   reusable_item_unit_logs[]
  departments     departments?              @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_department")
  items           items                     @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reusable_unit_item")
  receive_item    receive_item?             @relation(fields: [receive_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reusable_unit_receive_item")

  @@index([item_id], map: "idx_reusable_units_item_id")
  @@index([status], map: "idx_reusable_units_status")
  @@schema("inventory")
}

model reusable_item_unit_logs {
  id                 Int                 @id @default(autoincrement())
  unit_id            String              @db.Uuid
  action             String              @db.VarChar(30)
  from_department_id Int?
  to_department_id   Int?
  ref_doc_no         String?             @db.VarChar(50)
  note               String?
  performed_by       String?             @db.Uuid
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  reusable_item_unit reusable_item_units @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reusable_unit_log_unit")

  @@index([action], map: "idx_reusable_unit_logs_action")
  @@index([created_at], map: "idx_reusable_unit_logs_created_at")
  @@index([unit_id], map: "idx_reusable_unit_logs_unit_id")
  @@schema("inventory")
}

model lookup_sex {
  sex_code String @id(map: "PK_3d28c4cb17f318526ef564c9f84") @db.VarChar(1)
  sex      String @db.VarChar(100)

  @@schema("public")
}

