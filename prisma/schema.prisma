  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  notification    notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_recipient_notification")
  profiles        profiles      @relation(fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_recipient_profile")

  @@unique([notification_id, recipient_id], map: "uq_notification_recipient")
  @@index([recipient_id, is_read, created_at(sort: Desc)], map: "idx_notification_recipient_unread")
  @@index([recipient_id, created_at(sort: Desc)], map: "idx_notification_recipient_created")
  @@schema("inventory")
}

